{
	"permissions": {
		"defaultMode": "bypassPermissions"
	},
	"skipDangerousModePermissionPrompt": true,
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash .claude/scripts/format-edited-file.sh"
					}
				]
			}
		]
	}
}
