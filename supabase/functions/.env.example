# Used ONLY when running `supabase functions serve` locally for edge-function testing.
# In production, `ANTHROPIC_API_KEY` is set on the Supabase platform via
# `supabase secrets set ANTHROPIC_API_KEY=sk-ant-...` — never here.
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are auto-injected
# by the local Supabase stack (`supabase start`) — don't set them here.
ANTHROPIC_API_KEY=sk-ant-...
