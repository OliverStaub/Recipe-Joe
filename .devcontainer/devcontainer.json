{
	"name": "RecipeJoe (Svelte + Supabase + Vercel)",
	"build": {
		"dockerfile": "Dockerfile",
		"args": {
			"TZ": "${localEnv:TZ:Europe/Zurich}",
			"CLAUDE_CODE_VERSION": "latest",
			"GIT_DELTA_VERSION": "0.18.2",
			"ZSH_IN_DOCKER_VERSION": "1.2.0"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"svelte.svelte-vscode",
				"bradlc.vscode-tailwindcss",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"eamodio.gitlens",
				"supabase.vscode-supabase-extension"
			],
			"settings": {
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"editor.codeActionsOnSave": {
					"source.fixAll.eslint": "explicit"
				},
				"[svelte]": {
					"editor.defaultFormatter": "svelte.svelte-vscode"
				},
				"terminal.integrated.defaultProfile.linux": "zsh",
				"terminal.integrated.profiles.linux": {
					"bash": {
						"path": "bash",
						"icon": "terminal-bash"
					},
					"zsh": {
						"path": "zsh"
					}
				}
			}
		}
	},
	"remoteUser": "node",
	"mounts": [
		"source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
		"source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume",
		// Container-local node_modules so Linux native binaries don't clobber macOS ones
		// (and vice versa) when the host shares /workspace via bind mount.
		"source=recipejoe-node-modules-${devcontainerId},target=/workspace/node_modules,type=volume",
		// pnpm store, owned by `node` (we override store-dir to ~/.cache/pnpm-store anyway,
		// but a dedicated volume keeps the cache hot across rebuilds).
		"source=recipejoe-pnpm-cache-${devcontainerId},target=/home/node/.cache/pnpm-store,type=volume"
	],
	"forwardPorts": [5173],
	"portsAttributes": {
		"5173": {
			"label": "Vite dev server",
			"onAutoForward": "notify"
		}
	},
	"containerEnv": {
		"NODE_OPTIONS": "--max-old-space-size=4096",
		"CLAUDE_CONFIG_DIR": "/home/node/.claude",
		"POWERLEVEL9K_DISABLE_GITSTATUS": "true",
		"SUPABASE_PROJECT_REF": "${localEnv:SUPABASE_PROJECT_REF:}"
	},
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
	"workspaceFolder": "/workspace",
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"waitFor": "postCreateCommand"
}
