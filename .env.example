# Supabase — public, safe to expose in the browser
PUBLIC_SUPABASE_URL=https://wjetlcyndfifwphttwtw.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase CLI
SUPABASE_PROJECT_REF=wjetlcyndfifwphttwtw
# Optional: paste a personal access token from https://supabase.com/dashboard/account/tokens
# to skip `supabase login` interactively.
# SUPABASE_ACCESS_TOKEN=sbp_...

# NOTES on what is NOT in this file (and why):
# - SECRET key (sb_secret_...): never lives here. The SvelteKit app must respect RLS.
#   Inside the deployed edge function it's auto-injected as SUPABASE_SERVICE_ROLE_KEY.
# - ANTHROPIC_API_KEY: only the edge function needs it, on the Supabase platform.
#   Set it once with `supabase secrets set ANTHROPIC_API_KEY=sk-ant-...`.
#   For local edge-function testing only, see supabase/functions/.env.example.
