{
	"name": "recipejoe",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_REF --schema public > src/lib/types/database.ts",
		"db:reset": "supabase db reset --linked",
		"db:push": "supabase db push --linked",
		"fn:deploy": "supabase functions deploy recipe-import"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.11.0",
		"@sveltejs/adapter-vercel": "^5.4.4",
		"@sveltejs/kit": "^2.8.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22.9.0",
		"bits-ui": "^2.18.0",
		"eslint": "^9.14.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.45.1",
		"globals": "^15.12.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.3.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.1.16",
		"svelte-check": "^4.0.7",
		"svelte-sonner": "^1.1.1",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.0.0",
		"tslib": "^2.8.1",
		"tw-animate-css": "^1.2.0",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.13.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"@supabase/ssr": "^0.5.2",
		"@supabase/supabase-js": "^2.46.1",
		"clsx": "^2.1.1",
		"formsnap": "^2.0.0",
		"lucide-svelte": "^0.460.0",
		"sveltekit-superforms": "^2.20.1",
		"tailwind-merge": "^2.5.4",
		"zod": "^3.23.8"
	}
}
